# Neon PostgreSQL Database Connection URL
# Obtenha sua connection string em https://neon.tech
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/myfinance?sslmode=require"

# JWT Secret para sessões seguras
JWT_SECRET="myfinance-ultra-secure-jwt-secret-key-2026"

# ==============================================================================
# GMAIL SMTP (Envio de Códigos e Recuperação de Senha para QUALQUER usuário)
# ==============================================================================
# 1. Acesse: https://myaccount.google.com/apppasswords
# 2. Crie uma senha de app para "MyFinance"
# 3. Cole a senha de 16 letras no campo SMTP_PASS abaixo
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app-16-letras"
EMAIL_FROM="MyFinance <seu-email@gmail.com>"

# Porta do Servidor (opcional)
PORT=3000
