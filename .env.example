# Neon PostgreSQL Database Connection URL
# Obtenha sua connection string em https://neon.tech
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/myfinance?sslmode=require"

# JWT Secret para sessões seguras
JWT_SECRET="myfinance-ultra-secure-jwt-secret-key-2026"

# ==============================================================================
# REMETENTE CENTRAL DO SISTEMA (Para enviar e-mails a QUALQUER usuário do mundo)
# ==============================================================================
# O SMTP_USER é o CARTEIRO do sistema (quem envia).
# Quando qualquer usuário (Hotmail, Gmail, Yahoo, etc.) pedir recuperação,
# o sistema usará este carteiro para entregar a mensagem no e-mail do usuário.

# --- Opção 1: Brevo / antigo Sendinblue (GRÁTIS - 300 e-mails/dia para qualquer destinatário) ---
# Crie sua conta grátis em https://www.brevo.com -> Configurações SMTP
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="seu-login-brevo"
SMTP_PASS="sua-chave-smtp-brevo"
EMAIL_FROM="MyFinance <suporte@seusite.com>"

# --- Opção 2: Resend (https://resend.com - Recomendado para Next.js / Vercel) ---
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="MyFinance <onboarding@resend.dev>"

# --- Opção 3: Um Gmail dedicado para o sistema (ex: myfinance.notificacoes@gmail.com) ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="myfinance.notificacoes@gmail.com"
# SMTP_PASS="sua-senha-de-app-google-16-digitos"
# EMAIL_FROM="MyFinance <myfinance.notificacoes@gmail.com>"

# Porta do Servidor (opcional)
PORT=3000
